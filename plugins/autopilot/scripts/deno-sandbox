#!/bin/bash
set -euo pipefail

# Sandboxed Deno runner. See --help for usage.

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'HELP'
deno-sandbox — Run JS/TS in a sandboxed Deno environment.

Usage:
  # First, write code to the sandbox script file, then:
  deno-sandbox path/to/script.ts

  # With stdin data:
  cat data.csv | deno-sandbox path/to/script.ts

The script path can be absolute or relative (resolved to absolute).
Must be under .claude/deno-sandbox/ in the project directory.

Default: read-only access to current directory.
Use deno-sandbox-grant to add permissions for the session.

Note: symlinks in readable directories are followed to their targets.
HELP
  exit 0
fi

# The session-start hook exports all three together via CLAUDE_ENV_FILE.
PROJECT_DIR="${DENO_SANDBOX_PROJECT_DIR:-}"
sid="${DENO_SANDBOX_SESSION_ID:-}"
DATA_DIR="${AUTOPILOT_DATA_DIR:-}"
if [ -z "$PROJECT_DIR" ] || [ -z "$sid" ] || [ -z "$DATA_DIR" ]; then
  echo "error: sandbox is not configured for this session." >&2
  exit 1
fi

if ! command -v deno >/dev/null 2>&1; then
  echo "error: deno not found. It will be installed automatically on next session start." >&2
  exit 1
fi

# Require a script path argument
if [ $# -eq 0 ]; then
  echo "error: missing script path argument." >&2
  echo "Usage: deno-sandbox path/to/script.ts" >&2
  exit 1
fi

# Resolved like the script path below, so symlinked project dirs (/tmp on macOS) compare equal
SANDBOX_DIR="$(realpath "$PROJECT_DIR")/.claude/deno-sandbox"

# Resolve the script path (realpath also confirms the file exists)
SCRIPT_FILE=$(realpath "$1" 2>/dev/null) || {
  echo "error: script not found: $1" >&2
  exit 1
}

# Validate resolved path is under the sandbox directory
if [[ "$SCRIPT_FILE" != "$SANDBOX_DIR/"* ]]; then
  echo "error: script must be under $SANDBOX_DIR/" >&2
  exit 1
fi
if [[ "$SCRIPT_FILE" != *.ts ]]; then
  echo "error: script must be a .ts file" >&2
  exit 1
fi

if [[ "$sid" =~ [/\\] ]]; then
  echo "error: invalid session ID" >&2
  exit 1
fi

FLAGS=()
# Never writable, even when write is granted: .claude and .git under cwd, the
# project dir, the git toplevel and every granted dir, plus Claude's and Deno's
# home dirs and the grant state dir.
DENY_WRITE=(.claude .git "$PROJECT_DIR/.claude" "$PROJECT_DIR/.git" "$HOME/.claude" "$HOME/.deno" "$DATA_DIR")
git_toplevel=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$git_toplevel" ] && [ "$git_toplevel" != "$PROJECT_DIR" ]; then
  DENY_WRITE+=("$git_toplevel/.claude" "$git_toplevel/.git")
fi

# One flag per permission type; the default cwd read is the first read entry.
grant_read="." grant_write="" grant_run="" grant_net="" grant_env="" grant_import=""
STATE_FILE="$DATA_DIR/sessions/$sid"
if [ -f "$STATE_FILE" ]; then
  while IFS= read -r flag; do
    if [[ "$flag" =~ ^--allow-(read|write|run|net|env|import)=(.+)$ ]]; then
      kind="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"

      varname="grant_$kind"
      cur="${!varname}"
      if [ -n "$cur" ]; then
        printf -v "$varname" "%s,%s" "$cur" "$value"
      else
        printf -v "$varname" "%s" "$value"
      fi

      if [ "$kind" = "write" ] && [ -d "$value" ]; then
        DENY_WRITE+=("$value/.claude" "$value/.git")
      fi
    fi
  done < "$STATE_FILE"
fi

for kind in read write run net env import; do
  varname="grant_$kind"
  val="${!varname}"
  if [ -n "$val" ]; then
    FLAGS+=("--allow-$kind=$val")
  fi
done

deny_write_joined=$(IFS=,; echo "${DENY_WRITE[*]}")
FLAGS+=(--deny-write="$deny_write_joined")

exec env DENO_NO_PACKAGE_JSON=1 \
  deno run --no-config --node-modules-dir=none "${FLAGS[@]}" -- "$SCRIPT_FILE"
