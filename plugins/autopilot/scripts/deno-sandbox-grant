#!/bin/bash
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ $# -eq 0 ]; then
  cat <<'HELP'
deno-sandbox-grant — Grant additional Deno permissions for the session.

Usage:
  deno-sandbox-grant --allow-write=. --allow-net=api.example.com

Allowed flags (must include = with a scope):
  --allow-read=<path>     Read access to a directory or file
  --allow-write=<path>    Write access (.claude/ and .git/ always protected)
  --allow-run=<binary>    Run a specific command (e.g. git, python3)
  --allow-net=<host>      Network access to a specific host
  --allow-env=<VAR>       Access to a specific environment variable
  --allow-import=<host>   Import from a specific remote host

Grants persist for the rest of the session.
This command is NOT auto-allowed — it triggers a permission prompt.
HELP
  exit 0
fi

# Validate all flags before writing any (no partial state on error)
validated=()
for flag in "$@"; do
  if [[ "$flag" =~ ^--allow-(read|write|run|net|env|import)=(.+)$ ]]; then
    kind="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"

    # Resolve paths to absolute for read/write
    if [ "$kind" = "read" ] || [ "$kind" = "write" ]; then
      dir=$(dirname "$value")
      base=$(basename "$value")
      if [ -d "$value" ]; then
        resolved=$(cd "$value" && pwd)
      elif [ -d "$dir" ]; then
        resolved=$(cd "$dir" && echo "$(pwd)/$base")
      else
        echo "error: path does not exist: '$value'" >&2
        exit 1
      fi
      flag="--allow-$kind=$resolved"
    fi

    validated+=("$flag")
  else
    echo "error: rejected '$flag'" >&2
    echo "Only scoped --allow-{read,write,run,net,env,import}=<value> flags are accepted." >&2
    exit 1
  fi
done

# Verify flags are valid by running a no-op script with them
deno_err=$(echo '' | deno run --no-config "${validated[@]}" - 2>&1) || {
  echo "error: deno rejected the flags:" >&2
  echo "$deno_err" >&2
  exit 1
}

# Write validated flags to state file
if [ -z "${DENO_SANDBOX_SESSION_ID:-}" ]; then
  echo "error: sandbox is not available for this session." >&2
  exit 1
fi
STATE_DIR="${CLAUDE_PLUGIN_DATA:-$HOME/.cache/autopilot}/sessions"
STATE_FILE="$STATE_DIR/$DENO_SANDBOX_SESSION_ID"
mkdir -p "$STATE_DIR"

for flag in "${validated[@]}"; do
  if ! grep -qxF -- "$flag" "$STATE_FILE" 2>/dev/null; then
    echo "$flag" >> "$STATE_FILE"
  fi
done

echo "Granted for this session:"
for g in "${validated[@]}"; do
  echo "  $g"
done
