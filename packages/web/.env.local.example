# Generated by `bash scripts/setup-web.sh` (or manually).
# Non-secret defaults (WORKOS_CLIENT_ID, WORKOS_REDIRECT_URI) are in .env.

# Convex dev deployment (written by `convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS staging secrets
WORKOS_API_KEY=sk_test_...
WORKOS_COOKIE_PASSWORD=any-string-at-least-32-characters-long
