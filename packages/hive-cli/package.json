{
  "name": "@alignment-hive/hive-cli",
  "version": "0.1.21",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "lint": "tsc --noEmit -p src/tsconfig.json && eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "build:dev": "bun build --compile src/cli.ts --outfile ../../.dev/hive --define 'process.env.ALIGNMENT_HIVE_DEV=\"1\"'"
  },
  "dependencies": {
    "@alignment-hive/session-data": "workspace:*",
    "convex": "^1.31.0",
    "dotenv": "^17.3.1",
    "@inquirer/prompts": "^7",
    "@trpc/server": "^11",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.10.4",
    "prettier": "^3.5.3",
    "smol-toml": "^1.6.0",
    "typescript": "^5"
  }
}
