{
  "name": "@alignment-hive/hive-cli",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "lint": "tsc -p src/tsconfig.json && eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "generate-secret-rules": "bun src/scripts/generate-secret-rules.ts",
    "build:dev": "bun build --compile src/cli.ts --outfile ../../.dev/hive --define 'process.env.ALIGNMENT_HIVE_DEV=\"1\"'"
  },
  "dependencies": {
    "@alignment-hive/session-data": "workspace:*",
    "@inquirer/prompts": "^8.7.3",
    "@trpc/server": "^11.19.0",
    "convex": "^1.47.0",
    "css-tree": "^3.2.1",
    "dotenv": "^18.0.8",
    "markdown-it": "15.0.3",
    "parse5": "^8.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/bun": "latest",
    "@types/css-tree": "^3.2.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "diff": "9.0.0",
    "diff-match-patch": "^1.0.5",
    "highlight.js": "11.12.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "typescript": "^6.0.3"
  }
}
