{
  "permissions": {
    "allow": [
      "Bash(bun run --filter *)",
      "Bash(bun install)",
      "Bash(bun --version)",
      "Bash(cargo doc-md)",
      "Bash(cargo doc-md *)",
      "Bash(cargo fmt *)",
      "mcp__convex__*",
      "mcp__remote-kernels__*"
    ],
    "deny": [
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(tsc *)",
      "Bash(jest *)",
      "Bash(vitest *)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/seed-worktree-target.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  }
}
