{
  "permissions": {
    "allow": [
      "Bash(bun run --filter *)",
      "Bash(bun install)",
      "Bash(bun --version)",
      "Bash(cargo doc-md)",
      "Bash(cargo doc-md *)",
      "Bash(cargo fmt *)",
      "mcp__convex__*",
      "mcp__remote-kernels__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/seed-worktree-target.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  }
}
